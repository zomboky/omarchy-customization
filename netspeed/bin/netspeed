#!/usr/bin/env bash
# netspeed — network throughput for an Omarchy bar command module.
#
# Prints, on its last stdout line, a Waybar-style JSON object:
#   {"text": "↓ 320K  ↑ 12K", "tooltip": "wlo1   ↓ 320K   ↑ 12K"}
#
# The rate unit adapts: bytes/s below 1 KiB/s show as "0", below 1 MiB/s as
# KB/s (e.g. 320K), above as MB/s (e.g. 25.9M). Rates are derived from the
# cumulative byte counters of the default-route interface, across two
# invocations, over the real elapsed time (state file).

set -euo pipefail

state_file="${XDG_RUNTIME_DIR:-/tmp}/omarchy-netspeed.state"

# Interface backing the default route (the one carrying internet traffic).
iface="$(ip route show default 2>/dev/null \
  | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit }}')"

if [[ -z "${iface}" || ! -r "/sys/class/net/${iface}/statistics/rx_bytes" ]]; then
  rm -f "${state_file}"
  printf '{"text":"↓ -- ↑ --","tooltip":"Offline"}\n'
  exit 0
fi

rx="$(< "/sys/class/net/${iface}/statistics/rx_bytes")"
tx="$(< "/sys/class/net/${iface}/statistics/tx_bytes")"
now="$(date +%s.%N)"

prev_iface="" prev_ts="" prev_rx="" prev_tx=""
if [[ -r "${state_file}" ]]; then
  read -r prev_iface prev_ts prev_rx prev_tx < "${state_file}" || true
fi

printf '%s %s %s %s\n' "${iface}" "${now}" "${rx}" "${tx}" > "${state_file}"

awk -v iface="${iface}" \
    -v rx="${rx}" -v tx="${tx}" -v now="${now}" \
    -v p_iface="${prev_iface}" -v p_ts="${prev_ts}" \
    -v p_rx="${prev_rx}" -v p_tx="${prev_tx}" '
function fmt(b) {
  if (b < 1024)          return "0"
  if (b < 1048576)       return sprintf("%.0fK", b / 1024)
  if (b < 1073741824)    return sprintf("%.1fM", b / 1048576)
  return sprintf("%.1fG", b / 1073741824)
}
BEGIN {
  dt = now - p_ts
  if (p_iface == iface && p_ts != "" && dt > 0) {
    d = (rx - p_rx) / dt; if (d < 0) d = 0
    u = (tx - p_tx) / dt; if (u < 0) u = 0
  } else {
    d = 0; u = 0
  }
  text = sprintf("↓ %s  ↑ %s", fmt(d), fmt(u))
  tip  = sprintf("%s   ↓ %s   ↑ %s", iface, fmt(d), fmt(u))
  printf "{\"text\":\"%s\",\"tooltip\":\"%s\"}\n", text, tip
}
'
